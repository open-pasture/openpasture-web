# Every variable server.js reads. Copy to .env for local work (`npm run dev`
# loads it); on Railway, set the same names on the service.

# Resend API key. Leave unset locally: /api/contact then logs submissions to
# the console instead of sending. In production an unset key makes the form
# answer 503 with a pointer to the email address.
RESEND_API_KEY=

# Inbox that receives contact-form submissions. Required whenever
# RESEND_API_KEY is set; the server exits at start if it is missing.
CONTACT_EMAIL=

# Sender for those emails, on a domain verified in Resend, for example
# openpasture <hello@yourdomain>. Optional: unset, the server sends as
# Resend's test sender, which only delivers to the Resend account owner.
RESEND_FROM=

# Railway injects PORT; set it only for local runs.
PORT=3000

# Set to production on Railway. Leave unset locally.
# NODE_ENV=production

# RAILWAY_ENVIRONMENT is injected by Railway; do not set it. Its presence also
# marks the run as production.
